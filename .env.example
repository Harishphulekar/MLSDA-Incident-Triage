# ==============================================================================
# Production Incident Triage and Runbook Assistant - Environment Configuration
# All values below are placeholders. Copy to .env and configure for your environment.
# ==============================================================================

# Application & Service
APP_ENV=development
APP_PORT=8000
APP_HOST=0.0.0.0
SERVICE_NAME=incident-triage-api
LOG_LEVEL=INFO
DEBUG=false

# Worker Configuration
WORKER_CONCURRENCY=4
QUEUE_NAME=incident_triage_queue

# Redis Configuration
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Vector Database (ChromaDB / pgvector)
VECTOR_DB_TYPE=chroma
CHROMA_HOST=vector-db
CHROMA_PORT=8000

# OpenTelemetry & Jaeger
OTEL_SERVICE_NAME=incident-triage-assistant
OTEL_EXPORTER_OTLP_ENDPOINT=http://jaeger:4317
OTEL_TRACES_SAMPLER=always_on
ENABLE_TRACING=true

# Prometheus Metrics
PROMETHEUS_PORT=8000
PROMETHEUS_METRICS_PATH=/metrics

# LLM & Model Provider
LLM_PROVIDER=stub
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=placeholder-api-key-do-not-commit
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=1024

# Stub Model Settings (for load testing & offline evaluation)
STUB_MODEL_LATENCY_MS=150
STUB_MODEL_FAILURE_RATE=0.0

# Prompt Version Management
ACTIVE_PROMPT_VERSION=v1.1.0

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS_PER_MINUTE=60
RATE_LIMIT_BURST=10

# Caching Configuration
CACHE_ENABLED=true
CACHE_TTL_SECONDS=3600

# Cost Tracking Configuration
COST_PER_1K_PROMPT_TOKENS=0.00015
COST_PER_1K_COMPLETION_TOKENS=0.00060

# Security & Guardrails
ENABLE_INJECTION_DEFENSE=true
ENABLE_OUTPUT_FILTERING=true
ENABLE_TOXICITY_CHECK=true
MAX_ALERT_TEXT_LENGTH=4096
